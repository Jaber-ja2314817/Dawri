{
  "name": "dawri-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:inspect": "VITE_INSPECT=1 vite build --outDir .inspect-dist",
