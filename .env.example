# Copy to .env for local use. Without a token the app runs in simulated mode.

# Hugging Face token. Blank means simulated mode. Never commit a real one.
HF_TOKEN=
# Chat model used in real mode.
LLM_MODEL_ID=google/gemma-4-26B-A4B-it
# Inference Provider that serves the chat model.
LLM_PROVIDER=novita
# Speech-to-text model used in real mode.
ASR_MODEL_ID=openai/whisper-large-v3-turbo
# Inference Provider that serves the speech-to-text model.
ASR_PROVIDER=hf-inference
# Seconds allowed for one model or speech call.
LLM_TIMEOUT_SEC=10
# 1 fills the queues with simulated tickets. Any other value leaves them empty.
SIMULATE_LOAD=1
# Path of the SQLite file, relative to where the server starts.
DAWRI_DB=backend/data/dawri.db
# Folder of the built frontend. Blank uses backend/static, then frontend/dist.
DAWRI_STATIC_DIR=
